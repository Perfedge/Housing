{
  "name": "housing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/local.mjs",
    "start": "node --env-file-if-exists=.env server/local.mjs",
    "build": "node scripts/build.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "pg": "8.16.3",
    "jspdf": "4.2.1",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
